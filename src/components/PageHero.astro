---
interface Props {
  id?: string;
  title: string;
  titleId?: string;
  eyebrow: string;
  description?: string;
  breadcrumbs: { label: string; href?: string }[];
  image?: { src: string; width?: number; height?: number; position?: string };
}

const { id, title, titleId, eyebrow, description, breadcrumbs, image } = Astro.props;
---
<header id={id} class="content-hero" style={image?.position ? `--hero-image-position: ${image.position}` : undefined}>
  <div class="hero-media" data-hero-media hidden={!image} aria-hidden="true">
    {image && <img src={image.src} alt="" width={image.width} height={image.height} fetchpriority="high" />}
  </div>
  <div class="container hero-copy">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>{breadcrumbs.map(({ label, href }) => <li>{href ? <a href={href}>{label}</a> : <span aria-current="page">{label}</span>}</li>)}</ol>
    </nav>
    <p class="eyebrow">{eyebrow}</p>
    <h1 id={titleId}>{title}</h1>
    {description && <p class="hero-intro">{description}</p>}
    {Astro.slots.has('details') && <div class="hero-details"><slot name="details" /></div>}
  </div>
</header>

<style>
  .content-hero { position: relative; isolation: isolate; overflow: hidden; background: #252e2a; padding: 6.5rem 0 3rem; letter-spacing: 0; }
  .hero-media { position: absolute; z-index: -2; inset: 0; }
  /* The CMS can replace this image without Astro's scoped attributes. */
  .hero-media :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: var(--hero-image-position, center); }
  .content-hero::after { content: ''; position: absolute; z-index: -1; inset: 0; background: rgba(10, 25, 21, 0.72); pointer-events: none; }
  .hero-copy { color: #fff; }
  .breadcrumbs { margin-bottom: 1.5rem; font-size: 0.8rem; line-height: 1.6; }
  .breadcrumbs ol { display: flex; flex-wrap: wrap; gap: 0.4rem 0.75rem; list-style: none; padding: 0; margin: 0; }
  .breadcrumbs li { display: flex; align-items: baseline; gap: 0.75rem; min-width: 0; }
  .breadcrumbs li + li::before { content: '/'; color: #dbede7; }
  .breadcrumbs a { text-decoration: underline; text-underline-offset: 4px; }
  .breadcrumbs a:hover { text-decoration-thickness: 2px; }
  .breadcrumbs a:focus-visible { outline: 3px solid #b3eddb; outline-offset: 5px; }
  .eyebrow { color: #b3eddb; font-family: 'Space Mono', monospace; font-size: 0.75rem; line-height: 1.6; margin: 0 0 1rem; }
  h1 { color: #fff; font-size: 3.25rem; line-height: 1.15; letter-spacing: 0; max-width: 1000px; margin: 0; white-space: pre-line; overflow-wrap: anywhere; }
  .hero-intro { max-width: 610px; margin: 1.2rem 0 0; font-size: 1.125rem; line-height: 1.7; }
  .hero-details { margin-top: 1.25rem; }
  @media (max-width: 700px) {
    .content-hero { padding: 6rem 0 2.25rem; }
    h1 { font-size: 2.25rem; }
    .hero-intro { font-size: 1rem; }
  }
  @media (max-width: 360px) {
    .content-hero { padding: 5rem 0 1.5rem; }
    h1 { font-size: 1.75rem; }
    .eyebrow, .breadcrumbs { margin-bottom: 0.75rem; }
    .hero-intro { margin-top: 0.8rem; line-height: 1.6; }
    .hero-details { margin-top: 1rem; }
  }
  @media (max-height: 500px) and (min-width: 701px) {
    .content-hero { padding: 5.25rem 0 1.5rem; }
    h1 { font-size: 2rem; white-space: normal; }
    .eyebrow, .breadcrumbs { margin-bottom: 0.5rem; }
    .hero-intro { max-width: none; font-size: 1rem; line-height: 1.5; margin-top: 0.75rem; }
    .hero-details { margin-top: 0.75rem; }
  }
</style>
