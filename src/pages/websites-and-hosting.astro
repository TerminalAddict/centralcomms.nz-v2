---
import Layout from '../layouts/Layout.astro';
import { hostingOptions, hostingPlatform, websiteDelivery, websiteFaqs, websiteProjects, websiteUseCases } from '../data/websites-hosting';
import { jasonTestimonial } from '../data/it-support-testimonials';

const title = 'Web Design & NZ Hosting Hamilton | Central Comms';
const description = 'Hamilton web design, WordPress development and NZ hosting in Waikato, with backups to the Western Bay of Plenty. Domains, business email and 24/7 emergency support.';
const canonical = new URL('/websites-and-hosting.html', Astro.site).href;
const businessId = new URL('/#business', Astro.site).href;
const personId = new URL('/it-support.html#paul-willard', Astro.site).href;
const image = '/assets/images/websites-hosting/central-comms-websites-hosting-og.png';
const portrait = '/assets/images/it-support/paul-willard.webp';
const extraSchema = [
  {
    '@context': 'https://schema.org', '@type': 'Service', '@id': `${canonical}#service`,
    name: 'Website design, WordPress development and NZ web hosting',
    serviceType: 'Responsive business websites, landing pages, WordPress and custom development, managed NZ hosting, domains, business email and website maintenance',
    description: `${description} ${hostingPlatform.description}`, url: canonical,
    image: new URL(image, Astro.site).href, provider: { '@id': businessId },
    areaServed: [{ '@type': 'City', name: 'Hamilton' }, { '@type': 'AdministrativeArea', name: 'Waikato' }],
  },
  {
    '@context': 'https://schema.org', '@type': 'Person', '@id': personId,
    name: 'Paul Willard', jobTitle: 'Owner & IT Manager', url: personId,
    image: new URL(portrait, Astro.site).href, worksFor: { '@id': businessId },
    description: 'Paul Willard brings around three decades of telecommunications experience across systems administration, senior network engineering, network operations management and general management. His published work includes custom website and business-system integration, alongside CCL\'s WordPress and Proxmox hosting projects.',
    knowsAbout: ['Website development', 'WordPress', 'Business-system integration', 'Web hosting', 'Proxmox virtualisation', 'Systems administration', 'ISP operations'],
  },
  {
    '@context': 'https://schema.org', '@type': 'WebPage', '@id': `${canonical}#webpage`,
    name: title, description, url: canonical, inLanguage: 'en-NZ',
    about: { '@id': `${canonical}#service` }, mentions: { '@id': personId },
    publisher: { '@id': businessId },
    primaryImageOfPage: { '@type': 'ImageObject', url: new URL(image, Astro.site).href, width: 1200, height: 630 },
    breadcrumb: { '@id': `${canonical}#breadcrumb` }, hasPart: { '@id': `${canonical}#faqs` },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Websites and hosting', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage', '@id': `${canonical}#faqs`,
    url: `${canonical}#faqs`, inLanguage: 'en-NZ', isPartOf: { '@id': `${canonical}#webpage` },
    mainEntity: websiteFaqs.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })),
  },
];
const sections = [
  ['use-cases', 'Use cases'], ['development', 'WordPress & code'], ['hosting', 'NZ hosting'],
  ['domains-email', 'Domains & email'], ['maintenance', 'Maintenance'], ['projects', 'Our work'],
  ['seo', 'Search visibility'], ['faqs', 'FAQs'],
];
---
<Layout title={title} description={description} canonicalURL={canonical}
  image={image} imageWidth={1200} imageHeight={630}
  imageAlt="Central Communications website design and NZ hosting, with a view of its Proxmox hosting platform. Waikato hosting and Western Bay of Plenty backups."
  extraSchema={extraSchema}>
  <div class="webhosting-page">
    <header class="webhosting-hero">
      <img class="hero-image" src="/assets/images/websites-hosting/websites-hosting-infrastructure-hero.webp" alt="" width="2172" height="724" fetchpriority="high" />
      <div class="container hero-copy">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Websites &amp; hosting</span></nav>
        <p class="eyebrow">Hamilton &amp; Waikato</p>
        <h1>Websites that work.<br />Hosted here in NZ.</h1>
        <p class="hero-intro">Responsive websites, WordPress and NZ hosting, with local support from Hamilton.</p>
        <div class="actions"><a href="/#contact" class="btn btn-primary">Get a quote</a><a href="#hosting">NZ hosting <span aria-hidden="true">&darr;</span></a></div>
        <p class="hero-footnote">Waikato hosting &middot; Western Bay of Plenty backups</p>
      </div>
    </header>

    <nav class="page-index" aria-label="Website and hosting topics"><div class="container"><ul>{sections.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ul></div></nav>

    <section id="benefits" class="band" aria-labelledby="benefits-title">
      <div class="container">
        <div class="section-intro"><p class="eyebrow">From the first visit to the systems behind it</p><h2 id="benefits-title">Web design and hosting for Hamilton and Waikato businesses.</h2><p>Central Communications Ltd designs, develops, hosts and maintains business websites. We work with WordPress, build custom functionality where it is needed, and help coordinate domains, business email and the infrastructure that keeps a website available.</p><p>That combination is useful whether you need a straightforward service website, a focused landing page, a member area or a customer portal connected to existing systems. You can discuss the customer experience and the technical work behind it with the same local team.</p></div>
        <div class="three-columns benefits">
          <div><h3>A clear next step for customers</h3><p>Make your services easy to understand, your evidence easy to find and your enquiry route easy to use. Responsive design helps the same information work across phones, tablets and desktops.</p></div>
          <div><h3>Development beyond a template</h3><p>Our work includes WordPress member services, online marketplaces and business-system integration. When a requirement goes beyond the standard setup, we can investigate the application and the code.</p></div>
          <div><h3>Local hosting and ongoing care</h3><p>NZ-hosted infrastructure, off-site backups and a Hamilton support contact give the ongoing service a clear home. We also provide 24/7 emergency support for the services we look after.</p></div>
        </div>
      </div>
    </section>

    <section id="use-cases" class="band band-soft" aria-labelledby="use-cases-title">
      <div class="container"><div class="section-intro"><p class="eyebrow">Start with the job that needs doing</p><h2 id="use-cases-title">Where can a better website or hosting service help?</h2><p>The right project starts with a business need: more useful enquiries, easier publishing, a working customer process or a hosting arrangement you can rely on people to manage.</p></div><div class="use-case-grid">{websiteUseCases.map(({ title, need, approach, benefit }) => <article class="use-case"><h3>{title}</h3><p>{need}</p><p>{approach}</p><p class="outcome"><strong>The benefit:</strong> {benefit}</p></article>)}</div></div>
    </section>

    <section id="development" class="band band-green" aria-labelledby="development-title">
      <div class="container">
        <div class="profile-intro"><div><p class="eyebrow">Application knowledge meets infrastructure experience</p><h2 id="development-title">WordPress experience.<br />Serious programming depth.</h2><p>CCL's experience extends from editable WordPress websites to custom applications that connect with business systems. The Ulysses Motorcycle Club project brought together WordPress, member access, an online store and branch news. Wanna Internet required integration with customer records and a RADIUS user server.</p><p>Paul Willard brings hands-on technical leadership and around three decades of telecommunications experience, spanning systems administration, senior network engineering, network operations and general management. He understands that a website is an application running on infrastructure, not just a design handed over at launch.</p><p>Paul took over CCL's management in April 2022. His development and ISP background complements a local business established in 1989.</p><a class="text-link" href="/it-support.html#paul-willard">Paul's experience and qualifications</a></div><figure><img src={portrait} alt="Paul Willard, Central Communications owner and IT manager" width="640" height="640" loading="lazy" decoding="async" /><figcaption>Paul Willard &middot; Development, systems and business experience</figcaption></figure></div>
        <div class="two-columns development-grid">
          <div><h3>WordPress when editing matters</h3><p>A well-chosen WordPress setup can let your team maintain service information, news and other content without asking a developer to change every paragraph. We plan editing roles and the features you need, rather than simply accumulating plugins.</p><p>Good development also considers compatibility, supported themes and plugins, access, licences and future maintenance. Custom functionality needs an owner and an update path.</p></div>
          <div><h3>Custom code where it earns its place</h3><p>A customer portal, member workflow or integration may need more than a standard page builder. We map the inputs, permissions and business rules, then choose suitable existing components or develop the missing pieces.</p><p>Our TerminalAddict work shares technical knowledge, including custom WordPress functions. It reflects the same practical interest in understanding and improving the systems we use.</p><a class="text-link" href="/updates/terminaladdict.html">Our open-source and technical work</a></div>
        </div>
        <p class="practical-note">WordPress is an option, not an obligation. A lightweight static website can suit less frequently changed content; a bespoke application can suit a more specialised workflow. We explain the maintenance and ownership implications before recommending a platform.</p>
      </div>
    </section>

    <section id="hosting" class="band" aria-labelledby="hosting-title">
      <div class="container">
        <div class="hosting-intro"><div><p class="eyebrow">New Zealand infrastructure. Local accountability.</p><h2 id="hosting-title">Data-centre-level hosting in the heart of Waikato.</h2><p class="hosting-location"><strong>{hostingPlatform.description}</strong></p><p>Our Proxmox-based environment brings virtual-server management and infrastructure administration together. CCL's published virtual-hosting project documents hands-on work with a server cluster, alongside the website and application work that uses hosting services.</p><p>The benefit is access to people who can look beyond a generic hosting error. We can assess the application, resource needs, configuration and management responsibilities, then recommend a suitable service.</p><a class="text-link" href="/updates/virtual-hosting.html">Our Proxmox virtual-hosting work</a></div><figure class="platform-figure"><a href={hostingPlatform.image} data-hosting-platform aria-label="Enlarge the CCL hosting platform image"><img src={hostingPlatform.image} alt={hostingPlatform.imageAlt} width="1398" height="1089" loading="lazy" decoding="async" /></a><figcaption>CCL's current Proxmox hosting platform. An operational snapshot, not an uptime report or a promise of resources allocated to an individual customer.</figcaption></figure></div>
        <div class="three-columns hosting-principles">
          <div><h3>Capacity for the workload</h3><p>A brochure site, busy member area and database-backed portal have different demands. We consider application behaviour, storage, traffic and growth, not just a headline disk-space allowance.</p></div>
          <div><h3>Backups in another region</h3><p>Backups to the Western Bay of Plenty separate recovery copies from the Waikato hosting location. We agree the covered data, schedule, retention and restoration process for your service.</p></div>
          <div><h3>Clear management responsibilities</h3><p>Hosting, server administration and application maintenance are distinct jobs. We specify who handles each layer, including access, updates, certificate renewals and what to do when something fails.</p></div>
        </div>
        <h3 class="options-title">Choose the service around the application.</h3>
        <dl class="hosting-options">{hostingOptions.map(({ name, fit, scope, decision }) => <div><dt>{name}</dt><dd><p><strong>Good fit:</strong> {fit}</p><p>{scope}</p><p><strong>What we discuss:</strong> {decision}</p></dd></div>)}</dl>
        <p class="practical-note">A virtualisation platform, a backup and a high-availability service are not interchangeable. We confirm any uptime, recovery or response commitments for the actual package. Off-site backup does not by itself mean an automatic, uninterrupted failover service.</p>
        <p class="source-note">Platform background: <a href="https://www.proxmox.com/en/products/proxmox-virtual-environment/features" target="_blank" rel="noopener noreferrer">Proxmox VE capabilities</a>. The installed design and agreed service determine which capabilities apply.</p>
      </div>
    </section>

    <section id="domains-email" class="band band-soft" aria-labelledby="domains-title">
      <div class="container">
        <div class="section-intro"><p class="eyebrow">One domain. Different services.</p><h2 id="domains-title">Domain names and business email, properly coordinated.</h2><p>Your domain is the address customers remember. Its DNS records connect that address to the website, email and other services. We can manage these together while keeping the subscriptions, access and responsibilities clear.</p></div>
        <div class="two-columns domains-grid">
          <div><h3>Domain registration and management</h3><p>We help with new registrations, renewals, DNS changes and authorised transfers. Keep the business correctly recorded as the domain holder, with current contact information and a documented way to recover account access.</p><p>A change of website host does not necessarily require a new domain or a change of email provider. We check dependencies before changing nameservers or records.</p><a class="text-link" href="https://dnc.org.nz/tools-and-services/how-do-i-2/transfer-my-domain-name/" target="_blank" rel="noopener noreferrer">Domain Name Commission transfer guidance</a></div>
          <div><h3>Microsoft 365 or Google Workspace</h3><p>Use your business domain for email, with the provider and subscription that suit your team. We can help with setup, users, mailbox migration and supported devices, alongside the website and domain work.</p><p>Mailbox contents, shared addresses, licences, access security and recovery requirements need their own plan. Changing mail-routing records sends new messages to the chosen provider; it does not copy the old email across.</p><a class="text-link" href="/it-support.html">Business IT and email support</a></div>
          <div><h3>Protect the services that use your name</h3><p>Website forms, newsletters and business email may use different sending systems. We review those systems when configuring SPF, DKIM and DMARC so the domain's email-authentication policy fits legitimate senders.</p><p>Good configuration helps reduce domain impersonation, but is not a guarantee that every message will reach an inbox. Account security and ongoing administration still matter.</p></div>
          <div><h3>Keep website and email locations distinct</h3><p>Our NZ website hosting does not make every connected service NZ-hosted. Microsoft 365, Google Workspace, payment services and analytics have their own provider and data-location arrangements.</p><p>Tell us any specific location, retention or access requirements before selecting services. We can check the proposed setup instead of assuming that one hosting label covers everything.</p></div>
        </div>
        <p class="source-note">Provider guidance: <a href="https://learn.microsoft.com/en-us/microsoft-365/admin/get-help-with-domains/create-dns-records-at-any-dns-hosting-provider?view=o365-worldwide" target="_blank" rel="noopener noreferrer">Microsoft 365 domain setup</a>, <a href="https://knowledge.workspace.google.com/admin/domains/set-up-mx-records-for-google-workspace" target="_blank" rel="noopener noreferrer">Google Workspace mail routing</a> and <a href="https://www.ownyouronline.govt.nz/business/get-protected/guides/preventing-your-email-from-being-spoofed/" target="_blank" rel="noopener noreferrer">NCSC guidance on email spoofing</a>.</p>
      </div>
    </section>

    <section id="maintenance" class="band" aria-labelledby="maintenance-title">
      <div class="container">
        <div class="section-intro"><p class="eyebrow">Launch is the beginning of the service</p><h2 id="maintenance-title">SSL certificates, website maintenance and updates.</h2><p>A website needs ongoing care even when its content rarely changes. Software updates, expiring services, access changes and a broken enquiry form can all affect the business behind it.</p></div>
        <div class="two-columns maintenance-grid">
          <div><h3>HTTPS and certificate renewal</h3><p>We configure encrypted HTTPS connections and certificate renewal within the agreed hosting setup. Commonly called SSL certificates, today's certificates support TLS connections between visitors and the site.</p><p>Certificates protect information in transit. They do not make an outdated plugin safe or replace access controls and a recovery plan.</p></div>
          <div><h3>WordPress, plugins and themes</h3><p>Review supported versions, compatibility and the impact of updates. For a more complex change, a test environment and recovery route can help reduce disruption.</p><p>After updating, check the things customers actually use: enquiry delivery, bookings, member logins or ordering, as applicable. A working home page is not the whole test.</p></div>
          <div><h3>Backups you can use</h3><p>A typical WordPress recovery needs both the site files and its database. We consider what must be recovered, how much recent work could be lost and what restoration involves.</p><p>A short-term snapshot or a copy on the same storage is not automatically an independent backup. Retention, location and recovery checks belong in the maintenance discussion.</p></div>
          <div><h3>A defined care plan</h3><p>Agree who looks after the website, hosting, domain and third-party licences. Separate routine maintenance from new features, redesign work and additional content changes.</p><p>That makes ongoing costs easier to understand and gives the next change a clear starting point, whether it is a staff handover or a larger development project.</p></div>
        </div>
        <p class="source-note">Background: WordPress guidance on <a href="https://wordpress.org/documentation/article/updating-wordpress/" target="_blank" rel="noopener noreferrer">updates</a>, <a href="https://developer.wordpress.org/advanced-administration/security/backup/" target="_blank" rel="noopener noreferrer">backups</a> and <a href="https://developer.wordpress.org/advanced-administration/security/hardening/" target="_blank" rel="noopener noreferrer">security responsibilities</a>, plus <a href="https://letsencrypt.org/getting-started/" target="_blank" rel="noopener noreferrer">Let's Encrypt's HTTPS guidance</a>.</p>
      </div>
    </section>

    <section id="projects" class="band band-soft" aria-labelledby="projects-title">
      <div class="container">
        <div class="section-intro"><p class="eyebrow">Experience in practice</p><h2 id="projects-title">Website and hosting work with a purpose.</h2><p>Our previous projects span local business hosting, WordPress membership services, community marketplaces and custom integrations. From club memberships to ISP customer accounts, each project started with a different operational need.</p></div>
        <div class="project-grid">{websiteProjects.map((project) => <article class="project"><img src={project.image} alt={project.alt} width={project.width} height={project.height} loading="lazy" decoding="async" /><p class="project-category">{project.category}</p><h3>{project.title}</h3><p>{project.description}</p><p class="outcome">{project.relevance}</p><a class="text-link" href={project.href}>Read the {project.title} project</a></article>)}</div>
        <div class="customer-layout"><div><h3>A customer's view of the technical work</h3><p>For an ISP, customer records and service workflows are as important as the public website. Jason Brand at Wanna Internet describes Paul's contribution to that technical work.</p></div><figure class="customer-quote"><blockquote><p>{jasonTestimonial.quote}</p></blockquote><figcaption><picture><source type="image/webp" srcset="/assets/images/testimonials/Jason%20Brand-160.webp 1x, /assets/images/testimonials/Jason%20Brand-320.webp 2x" /><img src={jasonTestimonial.img} alt={jasonTestimonial.name} width="64" height="64" loading="lazy" decoding="async" /></picture><span><strong>{jasonTestimonial.name}</strong><span>{jasonTestimonial.company}</span></span></figcaption></figure></div>
      </div>
    </section>

    <section id="seo" class="band" aria-labelledby="seo-title">
      <div class="container">
        <div class="section-intro"><p class="eyebrow">Useful information, easy to find</p><h2 id="seo-title">Search engine optimisation starts with the essentials.</h2><p>We help give your website a sound foundation for discovery. Explain the services you actually offer, the people you help and the experience behind the business, then make that information accessible to visitors and search engines.</p></div>
        <div class="three-columns seo-grid">
          <div><h3>Content that answers real questions</h3><p>Useful service descriptions, relevant locations, genuine project examples and clear answers help people make a decision. Keep business details consistent and avoid pages that repeat the same keywords without adding anything useful.</p></div>
          <div><h3>Technical foundations</h3><p>Use descriptive titles, headings and links, sensible URLs, canonical tags and a sitemap. Align relevant structured data with visible facts. Check mobile usability, image efficiency and whether important content is available to crawlers.</p></div>
          <div><h3>Checks after publication</h3><p>Search Console can help identify indexing and crawl issues. Review broken links and redirects, keep the content current and measure useful customer actions, not just a single ranking snapshot.</p></div>
        </div>
        <div class="ai-guidance"><h3>What about ChatGPT, Claude and AI search?</h3><p>The aim is to make your business understandable and credible: accurate service information, real evidence, clear contact details and accessible text. Structured data should describe that content, not promise things the business cannot substantiate.</p><p>No developer can guarantee a ranking or recommendation from another platform. We focus on useful content and sound technical delivery, with ongoing review as your services and discovery tools change.</p></div>
        <p class="source-note">References: <a href="https://developers.google.com/search/docs/fundamentals/seo-starter-guide" target="_blank" rel="noopener noreferrer">Google's SEO Starter Guide</a> and <a href="https://developers.google.com/search/docs/appearance/ai-features" target="_blank" rel="noopener noreferrer">AI features and websites</a>.</p>
      </div>
    </section>

    <section id="delivery" class="band band-soft" aria-labelledby="delivery-title"><div class="container"><div class="section-intro"><p class="eyebrow">A clear route from brief to ongoing care</p><h2 id="delivery-title">A planned build, launch or hosting move.</h2><p>We agree the work before it starts: content, functionality, accounts, responsibilities and the handover. A provider move needs just as much attention to continuity as a brand-new website.</p></div><dl class="delivery-steps">{websiteDelivery.map(({ name, detail }) => <div><dt>{name}</dt><dd>{detail}</dd></div>)}</dl><p class="practical-note">Keep existing services active until the transfer plan and checks are complete. Website hosting, domain registration and email can move independently; cancelling the wrong service early can affect more than the website.</p></div></section>

    <section id="support" class="band band-green" aria-labelledby="support-title"><div class="container support-layout"><div><p class="eyebrow">A local contact when it matters</p><h2 id="support-title">24/7 emergency support.</h2><p>CCL provides 24/7 emergency support for the services we look after. Call for an urgent outage or serious service issue; use our support form for routine requests, content changes and planned work.</p><p>Tell us the affected website or service, when the problem started and what has changed. We can investigate the supported environment and coordinate the next steps.</p><p class="support-note">Emergency availability is not a promise of instant restoration or free recovery work. Response arrangements, charges and any service-level commitments are agreed for your service.</p></div><div class="support-actions"><a href="tel:+648008480038" class="btn btn-primary">Call 0800 848 0038</a><a class="text-link" href="/support.html#contact">Routine support request</a><a class="text-link" href="/notifications.html">Service notifications</a></div></div></section>

    <section id="faqs" class="band" aria-labelledby="faqs-title"><div class="container faq-layout"><div><p class="eyebrow">Before your next website decision</p><h2 id="faqs-title">Websites and hosting questions, answered.</h2><p>WordPress, NZ hosting, domains, email, backups, search visibility and the work that comes after launch.</p><a class="text-link" href="/#contact">Ask about your website</a></div><div class="faq-list">{websiteFaqs.map(({ question, answer }, index) => <details id={`webhosting-faq-${index + 1}`}><summary>{question}</summary><p>{answer}</p></details>)}</div></div></section>

    <section class="band contact-band" aria-labelledby="contact-title"><div class="container contact-inner"><div><p class="eyebrow">New website, better hosting or help with what you have</p><h2 id="contact-title">What does your website need to do?</h2><p>Send us your current website address, goals and any hosting or email concerns. We can put together a proposal that separates the initial work from ongoing hosting, licences and care.</p><a class="text-link" href="tel:+648008480038">Call 0800 848 0038</a></div><a href="/#contact" class="btn btn-primary">Talk about your project</a></div></section>

    <dialog id="hosting-platform-dialog" aria-labelledby="platform-dialog-title" aria-describedby="platform-dialog-description">
      <div class="dialog-heading"><h2 id="platform-dialog-title">CCL's Proxmox hosting platform</h2><form method="dialog"><button class="image-close" type="submit" autofocus>Close image <span aria-hidden="true">&times;</span></button></form></div>
      <img src={hostingPlatform.image} alt={hostingPlatform.imageAlt} width="1398" height="1089" loading="lazy" decoding="async" />
      <p id="platform-dialog-description">{hostingPlatform.description} This operational snapshot is not an uptime report or an individual customer's resource allocation.</p>
    </dialog>
  </div>

  <script>
    const dialog = document.querySelector<HTMLDialogElement>('#hosting-platform-dialog');
    const trigger = document.querySelector<HTMLAnchorElement>('[data-hosting-platform]');

    if (dialog && trigger && typeof dialog.showModal === 'function') {
      trigger.setAttribute('aria-haspopup', 'dialog');
      trigger.setAttribute('aria-controls', dialog.id);
      trigger.addEventListener('click', (event) => {
        // Preserve normal browser behaviour for modified image-link clicks.
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        if (dialog.open) return;
        const viewportWidth = document.documentElement.clientWidth;
        dialog.showModal();
        // WebKit can drop the reserved gutter when background scrolling is locked.
        const gutterLoss = Math.max(0, document.documentElement.clientWidth - viewportWidth);
        document.documentElement.style.setProperty('--hosting-modal-gutter', `${gutterLoss}px`);
      });
      dialog.addEventListener('close', () => {
        if (dialog.open) return;
        document.documentElement.style.removeProperty('--hosting-modal-gutter');
        trigger.focus({ preventScroll: true });
      });
      let backdropPointer = false;
      const outsideDialog = (event: MouseEvent) => {
        const rect = dialog.getBoundingClientRect();
        return event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom;
      };
      dialog.addEventListener('pointerdown', (event) => { backdropPointer = event.target === dialog && outsideDialog(event); });
      dialog.addEventListener('click', (event) => {
        if (backdropPointer && event.target === dialog && outsideDialog(event)) dialog.close();
        backdropPointer = false;
      });
    }
  </script>
</Layout>

<style>
  :global(html:has(.webhosting-page)) { scrollbar-gutter: stable; }
  :global(html:has(#hosting-platform-dialog[open])) { overflow: hidden; padding-right: var(--hosting-modal-gutter, 0px); }
  .webhosting-page { color: #263b40; background: #fff; line-height: 1.75; letter-spacing: 0; overflow-wrap: break-word; }
  .webhosting-page :is(h1, h2, h3, p, figure, blockquote, dl, dd) { margin: 0; }
  .webhosting-page :is(h1, h2, h3) { letter-spacing: 0; overflow-wrap: anywhere; }
  .webhosting-page h2 { font-size: 2.5rem; line-height: 1.15; margin-bottom: 1.4rem; }
  .webhosting-page h3 { font-size: 1.3rem; line-height: 1.35; margin-bottom: 0.8rem; }
