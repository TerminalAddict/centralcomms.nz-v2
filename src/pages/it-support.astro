---
import Layout from '../layouts/Layout.astro';
import { itFaqs, itSupportOptions, itUseCases, paulCredentials } from '../data/it-support';
import { ianTestimonial, jasonTestimonial } from '../data/it-support-testimonials';
import { aaronTestimonial } from '../data/voip-testimonials';

const title = 'Business IT Support Hamilton & Waikato | Central Comms';
const description = 'Local business IT support in Hamilton and Waikato. Computers, servers, networks and private cloud, backed by Paul Willard\'s technical and business experience.';
const canonical = new URL('/it-support.html', Astro.site).href;
const businessId = new URL('/#business', Astro.site).href;
const personId = `${canonical}#paul-willard`;
const image = '/assets/images/it-support/central-comms-it-support-og.png';
const portrait = '/assets/images/it-support/paul-willard.webp';
const testimonials = [ianTestimonial, aaronTestimonial, jasonTestimonial];
const extraSchema = [
  {
    '@context': 'https://schema.org', '@type': 'Service', '@id': `${canonical}#service`,
    name: 'Business IT support in Hamilton and Waikato',
    serviceType: 'Business IT support, hardware supply and repairs, network and server support, private-cloud planning and remote hands',
    description, url: canonical, image: new URL(image, Astro.site).href,
    provider: { '@id': businessId },
    areaServed: [{ '@type': 'City', name: 'Hamilton' }, { '@type': 'AdministrativeArea', name: 'Waikato' }],
  },
  {
    '@context': 'https://schema.org', '@type': 'Person', '@id': personId,
    name: 'Paul Willard', jobTitle: 'Owner & IT Manager',
    url: personId, image: new URL(portrait, Astro.site).href,
    worksFor: { '@id': businessId },
    description: 'Paul Willard brings around three decades of telecommunications experience across systems administration, senior network engineering, network operations management and general management. He took over management of Central Communications in April 2022.',
    knowsAbout: ['Systems administration', 'Network engineering', 'ISP operations', 'Enterprise wireless networking', 'Broadband wireless networking', 'Business management', 'IBM AIX', 'Structured network installation'],
    hasCredential: paulCredentials.map(({ name, category, record, benefit, identifier, expires, recognizedBy }) => ({
      '@type': 'EducationalOccupationalCredential', name, credentialCategory: category,
      description: `${record} ${benefit}`,
      ...(identifier ? { identifier } : {}),
      ...(expires ? { expires } : {}),
      ...(recognizedBy ? { recognizedBy } : {}),
    })),
  },
  {
    '@context': 'https://schema.org', '@type': 'WebPage', '@id': `${canonical}#webpage`,
    url: canonical, name: title, description, inLanguage: 'en-NZ',
    about: { '@id': `${canonical}#service` }, mentions: { '@id': personId },
    publisher: { '@id': businessId },
    primaryImageOfPage: { '@type': 'ImageObject', url: new URL(image, Astro.site).href, width: 1200, height: 630 },
    breadcrumb: { '@id': `${canonical}#breadcrumb` }, hasPart: { '@id': `${canonical}#faqs` },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'IT support', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage', '@id': `${canonical}#faqs`,
    url: `${canonical}#faqs`, inLanguage: 'en-NZ', isPartOf: { '@id': `${canonical}#webpage` },
    mainEntity: itFaqs.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })),
  },
];
const sections = [
  ['benefits', 'Benefits'], ['use-cases', 'When you need IT support'], ['paul-willard', 'Meet Paul'],
  ['qualifications', 'Qualifications'], ['support-options', 'Support options'], ['cloud', 'Servers & cloud'],
  ['customer-stories', 'Our work'], ['faqs', 'FAQs'],
];
---
<Layout title={title} description={description} canonicalURL={canonical}
  image={image} imageWidth={1200} imageHeight={630}
  imageAlt="Business IT support in Hamilton and Waikato from Central Communications. Computers, servers, networks and private cloud."
  extraSchema={extraSchema}>
  <div class="it-page">
    <header class="it-hero">
      <img class="hero-image" src="/assets/images/it-support/it-support-workstation-hero.webp"
        srcset="/assets/images/it-support/it-support-workstation-hero-960.webp 960w, /assets/images/it-support/it-support-workstation-hero.webp 2048w"
        sizes="100vw" alt="Central Communications workstation with multiple monitors, technical tools and software development in progress"
        width="2048" height="946" fetchpriority="high" />
      <div class="container hero-copy">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">IT support</span></nav>
        <p class="eyebrow">Hamilton &amp; Waikato</p>
        <h1>IT support.<br />Experience that counts.</h1>
        <p class="hero-intro">Local help for computers, servers and networks. Deep technical experience with a business perspective.</p>
        <div class="actions"><a href="/support.html#contact" class="btn btn-primary">Get IT support</a><a href="#paul-willard">Meet Paul <span aria-hidden="true">&darr;</span></a></div>
        <p class="hero-footnote">Business IT &middot; Hardware &middot; Networks &middot; Private cloud</p>
      </div>
    </header>

    <nav class="page-index" aria-label="IT support topics"><div class="container"><ul>{sections.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ul></div></nav>

    <section id="benefits" class="band" aria-labelledby="benefits-title">
      <div class="container">
        <div class="section-intro"><p class="eyebrow">Keep the business moving</p><h2 id="benefits-title">Business IT support in Hamilton, with the bigger picture in mind.</h2><p>Central Communications Ltd provides business IT support in Hamilton and across Waikato: computers, hardware repairs, servers, networking, private-cloud projects and remote hands for other IT providers. We help with the immediate fault and the decisions that come after it.</p><p>Established in 1989, Central Communications brings a long local history. Today, Paul Willard leads the business with a combination of hands-on technical experience and postgraduate business qualifications. You can discuss a stubborn network fault and the operational reasons for investing in a better system with the same team.</p></div>
        <div class="three-columns benefits">
          <div><h3>Find the cause, not just the symptom</h3><p>A slow application may involve a computer, server, wireless connection or upstream service. Broad infrastructure experience helps us investigate the whole path and work with the right supplier when the fault sits outside your own equipment.</p></div>
          <div><h3>Make informed spending decisions</h3><p>Repair, upgrade, replace or migrate? We explain the practical trade-offs around workload, supportability, cost and disruption. The most expensive option is not automatically the most useful one for your business.</p></div>
          <div><h3>Have someone local to work with</h3><p>Remote support can handle many questions, but some jobs need a person at the site. We can connect the desk-level problem to the cabling, network and server infrastructure behind it, with clear next steps.</p></div>
        </div>
      </div>
    </section>

    <section id="use-cases" class="band band-soft" aria-labelledby="use-cases-title">
      <div class="container">
        <div class="section-intro"><p class="eyebrow">When technology starts holding you back</p><h2 id="use-cases-title">When does a business need IT support?</h2><p>You do not need a major outage to ask for help. Recurring small problems, a growing team or an approaching equipment replacement can be a good time to bring in experienced support.</p></div>
        <div class="use-case-grid">{itUseCases.map(({ title, need, approach, benefit }) => <article class="use-case"><h3>{title}</h3><p>{need}</p><p>{approach}</p><p class="outcome"><strong>The benefit:</strong> {benefit}</p></article>)}</div>
      </div>
    </section>

    <section id="paul-willard" class="band" aria-labelledby="paul-title">
      <div class="container">
        <div class="profile-intro">
          <div><p class="eyebrow">Paul Willard &middot; Owner &amp; IT Manager</p><h2 id="paul-title">Technical depth.<br />Business judgement to match.</h2><p><strong>Paul is a highly qualified, hands-on technology professional with around three decades of telecommunications experience.</strong> His career spans systems administration, senior network engineering, network operations management and general management at internet and telecommunications companies.</p><p>That breadth matters. He has worked on the systems people use, the networks carrying their traffic and the operations responsible for keeping services running. His MBA and postgraduate business diploma add a management perspective to the technical work: priorities, costs, people and the consequences of a change.</p><p>Paul took over management of Central Communications in <strong>April 2022</strong>. He brings that combination to businesses that need practical help today and a credible plan for what comes next.</p><a class="text-link" href="/about.html">Meet the Central Communications team</a></div>
          <figure><img src={portrait} alt="Paul Willard, Owner and IT Manager at Central Communications" width="640" height="640" loading="lazy" decoding="async" /><figcaption>Paul Willard, Owner &amp; IT Manager.</figcaption></figure>
        </div>
        <div class="two-columns experience">
          <div><h3>Systems administration to network engineering</h3><p>Server administration and network engineering provide different views of the same problem. Paul can consider users, storage, services and network paths together, which is useful when a fault does not stay neatly inside one supplier's product.</p></div>
          <div><h3>ISP and telecommunications operations</h3><p>Network operations and management experience brings an understanding of capacity, service dependencies, escalation and coordinated changes. It helps frame the questions that matter when internet, phones and business applications share infrastructure.</p></div>
          <div><h3>Technical leadership with business context</h3><p>General management experience and postgraduate business study help turn a technical recommendation into a decision a business can act on. The conversation includes what matters most, what can wait and what the ongoing responsibility will be.</p></div>
          <div><h3>Practical software as well as infrastructure</h3><p>Paul also develops tools such as SADPTools and NX Camera Info for CCTV commissioning and system documentation. That is another part of the same approach: understanding the information, building useful tools and making technical work easier to maintain.</p><a class="text-link" href="/cctv.html#apps">Explore Paul's CCTV tools</a></div>
        </div>
      </div>
    </section>

    <section id="qualifications" class="band band-green" aria-labelledby="qualifications-title">
      <div class="container">
        <div class="section-intro"><p class="eyebrow">Qualifications, training &amp; approval</p><h2 id="qualifications-title">A broad foundation, backed by real experience.</h2><p>Paul's record combines business education, systems administration, wired and wireless networking, and personal approval for relevant private-security work. These are different strengths, not interchangeable qualifications.</p></div>
        <div class="credential-labels" aria-hidden="true"><span>Qualification or training</span><span>Record</span><span>What it adds</span></div>
        <dl class="credential-list" aria-label="Paul Willard's qualifications and training">{paulCredentials.map(({ name, record, benefit }) => <div><dt>{name}</dt><dd class="credential-record">{record}</dd><dd class="credential-benefit">{benefit}</dd></div>)}</dl>
        <p class="source-note">Years record when qualifications or training were achieved. Vendor certificates can have renewal requirements; the dated entries are not a blanket claim of current vendor certification. For a tender or procurement requirement, ask us to confirm the relevant current status.</p>
        <p class="source-note references">Course and regulatory references: <a href="https://www.justice.govt.nz/tribunals/licences-certificates/pspla/apply-or-renew/who-needs-a-licence-or-certificate/" target="_blank" rel="noopener noreferrer">PSPLA</a>, <a href="https://www.legrand.co.nz/" target="_blank" rel="noopener noreferrer">Legrand New Zealand</a>, <a href="https://mikrotik.com/training/about" target="_blank" rel="noopener noreferrer">MikroTik training and certification</a>, <a href="https://dl.ui.com/guides/training/courses/UEWA_Training_Guide_V2.1.pdf" target="_blank" rel="noopener noreferrer">UEWA course guide (PDF)</a>, <a href="https://dl.ui.com/guides/training/courses/UBWA_Training_Guide.pdf" target="_blank" rel="noopener noreferrer">UBWA course guide (PDF)</a> and <a href="https://www.ibm.com/training/badge/mastering-ibm-aix-implementation-and-administration" target="_blank" rel="noopener noreferrer">IBM AN12G course overview</a>.</p>
      </div>
    </section>

    <section id="support-options" class="band" aria-labelledby="support-options-title">
      <div class="container">
        <div class="section-intro"><p class="eyebrow">The right help for the job</p><h2 id="support-options-title">Remote, on-site or alongside your existing IT team.</h2><p>Some problems need a short investigation; others need a planned project. We agree what you need, the access available and who is responsible for each part before recommending the next step.</p></div>
        <div class="support-options">{itSupportOptions.map(({ name, fit, plan }) => <article><h3>{name}</h3><div><p>{fit}</p><p>{plan}</p></div></article>)}</div>
        <div class="two-columns practical-notes">
          <div><h3>Hardware that suits the workload</h3><p>We supply desktops, laptops and servers, build systems for specific needs and investigate repair options. Tell us which applications people use, the peripherals they rely on and how long the equipment is expected to remain in service.</p><p>We consider compatibility, support, storage, repairability and data transfer as well as the specification on the box. Software licences, warranties and migration work should be clear in the quote.</p></div>
          <div><h3>Remote access with your agreement</h3><p>We use HelpWire for arranged remote-support sessions. Contact us first, follow the instructions we provide and confirm that you are dealing with our team before allowing access. Keep passwords and recovery codes out of support messages.</p><p>Remote access is not a substitute for every site visit, and using a remote-support tool does not mean all support labour is free.</p><a class="text-link" href="/support.html">Support contact details and remote-help information</a></div>
        </div>
      </div>
    </section>

    <section id="cloud" class="band band-soft" aria-labelledby="cloud-title">
      <div class="container">
        <div class="section-intro"><p class="eyebrow">Keep the options open</p><h2 id="cloud-title">Servers, private cloud and a plan for recovery.</h2><p>A server replacement is a business decision as well as a technical one. Your applications, users, internet connection, licensing and recovery needs determine whether an on-site system, a hosted environment or a combination makes sense.</p><p>Central Communications works with server infrastructure and private-cloud migrations. We assess the job before choosing the destination. Private cloud can offer useful control, but it still needs maintenance, access management, backups and someone responsible for the service.</p></div>
        <div class="three-columns">
          <div><h3>Understand the dependencies</h3><p>Identify which applications and data belong together, how people connect and what the software suppliers support. Moving a server without understanding those relationships can simply move the problem somewhere else.</p></div>
          <div><h3>Make the change testable</h3><p>Agree what success looks like, what must be checked before cutover and how to return to the previous setup if necessary. Schedule the change around business activity and include the people who use the applications.</p></div>
          <div><h3>Know what recovery involves</h3><p>Decide what data must be protected, how much recent work could be lost and how quickly the business needs to resume. Backup coverage, retention, restore tests and responsibility need to be explicit.</p></div>
        </div>
        <div class="practical-note"><h3>Backups and access controls are ongoing work</h3><p>A backup job reporting success is not proof that every application can be recovered. Likewise, a strong password alone is not a complete account-security plan. We can help scope practical improvements to supported systems, including restore testing, appropriate permissions, updates and multi-factor authentication.</p><p>These measures reduce risk; they do not guarantee that an outage or security incident cannot happen. For further guidance, see the New Zealand NCSC on <a href="https://www.ncsc.govt.nz/protect-your-organisation/implement-and-test-backups/" target="_blank" rel="noopener noreferrer">implementing and testing backups</a> and <a href="https://www.ncsc.govt.nz/protect-your-organisation/multi-factor-authentication-and-verification/" target="_blank" rel="noopener noreferrer">multi-factor authentication</a>.</p></div>
        <p class="related-services">The physical network matters too. We also provide <a href="/networking--data.html">structured data cabling</a>, <a href="/wireless.html">business Wi-Fi</a>, <a href="/voip.html">cloud phone systems</a> and <a href="/cctv.html">CCTV installation and support</a>.</p>
      </div>
    </section>

    <section id="customer-stories" class="band" aria-labelledby="customer-title">
      <div class="container">
        <div class="section-intro"><p class="eyebrow">Work that connects systems and people</p><h2 id="customer-title">Practical experience, in our customers' words.</h2><p>From helping a pharmacy solve everyday problems to developing technical systems for an internet provider, our work connects business needs with the technology behind them.</p></div>
        <div class="testimonials">{testimonials.map(({ name, company, img, quote }) => <figure class="testimonial"><blockquote><p>{quote}</p></blockquote><figcaption><picture><source type="image/webp" srcset={`${img.replace(/\.(jpg|png)$/i, '-160.webp')} 1x, ${img.replace(/\.(jpg|png)$/i, '-320.webp')} 2x`} /><img src={img} alt={name} width="64" height="64" loading="lazy" decoding="async" /></picture><span><strong>{name}</strong><span>{company}</span></span></figcaption></figure>)}</div>
        <div class="two-columns project-notes">
          <article><h3>Systems behind Wanna Internet</h3><p>Our Wanna Internet project connected a bespoke website with its customer database and RADIUS user server, alongside a customer control panel. It is an example of work that crosses software, information and telecommunications systems.</p><a class="text-link" href="/updates/wanna-internet.html">Read the Wanna Internet project</a></article>
          <article><h3>Hands-on virtualisation experience</h3><p>Our virtual-hosting update documents Central Communications' use of Proxmox for a server cluster. That hands-on infrastructure experience informs the questions we ask about capacity, application requirements and ongoing administration when planning a server project.</p><a class="text-link" href="/updates/virtual-hosting.html">Read about our virtual-hosting work</a></article>
        </div>
      </div>
    </section>

    <section id="faqs" class="band band-soft" aria-labelledby="faqs-title">
      <div class="container faq-layout"><div><p class="eyebrow">Before you get in touch</p><h2 id="faqs-title">IT support questions, answered.</h2><p>Getting help, choosing hardware, working with your IT team and understanding the experience behind the advice.</p><a class="text-link" href="/support.html#contact">Ask us about your IT</a></div><div class="faq-list">{itFaqs.map(({ question, answer }, index) => <details id={`it-faq-${index + 1}`}><summary>{question}</summary><p>{answer}</p></details>)}</div></div>
    </section>

    <section class="band contact-band" aria-labelledby="contact-title"><div class="container contact-inner"><div><p class="eyebrow">A problem today. A plan for tomorrow.</p><h2 id="contact-title">What is getting in the way of work?</h2><p>Tell us what is happening, who is affected and what your business needs next. We will help work out the next step, whether that is a remote session, a site visit or a properly scoped project.</p><a class="text-link" href="tel:+648008480038">Call 0800 848 0038</a></div><a href="/support.html#contact" class="btn btn-primary">Talk to Central Communications</a></div></section>
  </div>
</Layout>

<style>
  .it-page { color: #263b40; background: #fff; line-height: 1.75; letter-spacing: 0; overflow-wrap: break-word; }
  .it-page :is(h1, h2, h3, p, figure, blockquote) { margin: 0; }
  .it-page :is(h1, h2, h3) { letter-spacing: 0; overflow-wrap: anywhere; }
  .it-page h2 { font-size: 2.5rem; line-height: 1.15; margin-bottom: 1.4rem; }
  .it-page h3 { font-size: 1.3rem; line-height: 1.35; margin-bottom: 0.8rem; }
  .it-page p + p { margin-top: 1rem; }
  .it-page a:not(.btn) { text-decoration: underline; text-underline-offset: 4px; }
  .it-page a:hover { text-decoration-thickness: 2px; }
  .it-page :is(a, summary, [tabindex]):focus-visible { outline: 3px solid #007b63; outline-offset: 5px; }
  .it-page .btn { letter-spacing: 0; text-align: center; justify-content: center; border-radius: 6px; white-space: normal; }
  .it-page .btn-primary { background: #0369a1; color: #fff; }
  .it-page .btn-primary:hover { background: #075985; }
  .it-page .eyebrow { color: #006b55; font-family: 'Space Mono', monospace; font-size: 0.75rem; line-height: 1.6; margin-bottom: 1rem; }
  .band { padding: 5rem 0; scroll-margin-top: 5rem; }
  .band-soft { background: #f3f6f6; }
  .band-green { background: #eaf5ef; }
  .section-intro { max-width: 800px; margin-bottom: 3rem; }
  .it-hero { position: relative; isolation: isolate; overflow: hidden; background: #252e2a; padding: 6.5rem 0 3rem; }
  .hero-image { position: absolute; z-index: -2; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 35%; }
  .it-hero::after { content: ''; position: absolute; z-index: -1; inset: 0; background: rgba(10, 25, 21, 0.72); }
  .hero-copy { color: #fff; }
  .breadcrumbs { display: flex; gap: 0.75rem; font-size: 0.8rem; margin-bottom: 1.5rem; }
  .it-hero .eyebrow { color: #b3eddb; }
  .it-hero h1 { font-size: 3.5rem; color: #fff; max-width: 900px; margin-bottom: 1.2rem; }
  .hero-intro { max-width: 610px; font-size: 1.125rem; line-height: 1.7; }
  .actions { display: flex; flex-wrap: wrap; gap: 1.25rem 1.75rem; align-items: center; margin: 1.6rem 0 1.2rem; }
  .hero-footnote { color: #dbede7; font-size: 0.8rem; }
  .it-hero a:focus-visible { outline-color: #b3eddb; }
  .page-index { border-bottom: 1px solid #d6e3de; background: #fff; }
  .page-index ul { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; padding: 1.25rem 0; margin: 0; list-style: none; }
  .page-index a { display: inline-block; font-size: 0.875rem; padding: 0.25rem 0; color: #245f56; }
  .two-columns, .three-columns, .use-case-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem; }
  .three-columns, .use-case-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .benefits > div { border-top: 2px solid #c3e1d3; padding-top: 1.5rem; }
  .use-case, .experience > div { border-top: 1px solid #b9cdc5; padding-top: 1.5rem; }
  .outcome { color: #00634e; font-size: 0.95rem; }
  .text-link { display: inline-block; margin-top: 1.25rem; font-weight: 600; color: #03658d; }
  .profile-intro { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr); gap: 4rem; align-items: center; margin-bottom: 3rem; }
  .profile-intro figure { max-width: 360px; justify-self: end; }
  .profile-intro img { width: 100%; height: auto; }
  .profile-intro figcaption { margin-top: 0.75rem; }
  .it-page figcaption { font-size: 0.875rem; line-height: 1.6; color: #4e6463; }
  .credential-labels, .credential-list > div { display: grid; grid-template-columns: minmax(0, 28fr) minmax(0, 25fr) minmax(0, 47fr); font-size: 0.95rem; }
  .credential-labels { background: #d8ebe0; color: #174b40; font-weight: 700; }
  .credential-labels > span, .credential-list :is(dt, dd) { padding: 1.2rem; margin: 0; }
  .credential-list { margin: 0 0 1rem; }
  .credential-list > div { border-bottom: 1px solid #c6dbd1; }
  .credential-list dt { color: #193b39; font-weight: 700; }
  .source-note { font-size: 0.85rem; line-height: 1.7; color: #405956; max-width: 1000px; }
  .support-options article { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 3rem; padding: 1.75rem 0; border-top: 1px solid #bfd4cc; }
  .practical-notes { margin-top: 3rem; }
  .practical-note { border-left: 3px solid #00735c; padding-left: 1.5rem; margin: 3rem 0 2rem; max-width: 900px; }
  .testimonials { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
  .testimonial { display: flex; flex-direction: column; justify-content: space-between; border-top: 3px solid #006b55; padding-top: 1.5rem; }
  .testimonial blockquote { font-size: 0.95rem; }
  .testimonial figcaption { display: flex; align-items: center; gap: 1rem; margin-top: 1.75rem; }
  .testimonial picture { flex: 0 0 64px; }
  .testimonial img { width: 64px; height: 64px; object-fit: cover; border-radius: 4px; }
  .testimonial figcaption strong, .testimonial figcaption span span { display: block; }
  .testimonial figcaption strong { color: #183b36; font-size: 0.95rem; }
  .project-notes { margin-top: 3.5rem; }
  .project-notes article { border-top: 1px solid #b9cdc5; padding-top: 1.5rem; }
  .faq-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 4rem; }
  .faq-list { min-width: 0; }
  details { border-top: 1px solid #bfd4cc; scroll-margin-top: 6rem; }
  details:last-child { border-bottom: 1px solid #bfd4cc; }
  summary { cursor: pointer; font-weight: 600; color: #193b39; padding: 1.2rem 0; line-height: 1.5; }
  summary::marker { color: #00735c; }
  details[open] summary { color: #00634e; }
  details p { padding: 0 0 1.5rem; }
  .contact-band { background: #deeee7; }
  .contact-inner { display: flex; gap: 3rem; align-items: center; justify-content: space-between; }
  .contact-inner > div { max-width: 650px; }
